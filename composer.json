{
    "require": {
        "pocketmine/pocketmine-mp": "^5.36.0",
        "cortexpe/commando": "dev-master#62db2be0ef4b5d509ee2832de876fdb4da401b6e",
        "muqsit/simple-packet-handler": "dev-pm5",
        "muqsit/invmenu": "dev-pm5"
    },
    "require-dev": {
        "axolotl-pm/pocketmine-mp": "5.49.1",
        "phpstan/phpstan": "2.3.1",
        "friendsofphp/php-cs-fixer": "^3.17"
    },
    "autoload": {
        "psr-4": {
            "NhanAZ\\RedSkyBlockX\\": "src/NhanAZ/RedSkyBlockX/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0",
            "ext-chunkutils2": "0.3.1",
            "ext-crypto": "0.3.1",
            "ext-encoding": "1.0.0",
            "ext-igbinary": "3.0.1",
            "ext-leveldb": "0.2.1",
            "ext-morton": "0.1.0",
            "ext-pmmpthread": "6.1.0",
            "ext-yaml": "2.0.0"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ]
}
